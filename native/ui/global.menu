#include "ui/menudef.h"

assetGlobalDef {
 font UI_FONT_ARIBLK_16 "ariblk" 16
 font UI_FONT_ARIBLK_27 "ariblk" 27
 font UI_FONT_COURBD_21 "courbd" 21
 font UI_FONT_COURBD_30 "courbd" 30
 cursor "ui/assets/3_cursor3"
 gradientBar "ui/assets/gradientbar1.tga"
 itemFocusSound "sound/misc/menu2.wav"
 fadeClamp 1.0
 fadeCycle 1
 fadeAmount 0.1
 shadowColor 0.1 0.1 0.1 0.25
}

menuDef {
 name "backgroundmusic"
 fullScreen 1
 visible 1
 onOpen {
  playlooped "sound/music/menu_server.wav"
 }
}

// The generated panorama is drawn once across the real viewport by UI_Refresh.
// Retain native logos and controls on the aspect-correct central canvas.
menuDef {
 name "background_1"
 fullScreen 0
 rect 0 0 640 480
 visible 0
 itemDef {
  name "image"
  rect 120 140 400 200
  style WINDOW_STYLE_SHADER
  background "ui/assets/et_logo_huge_dark"
  visible 1
  decoration
 }
}

menuDef {
 name "background_black"
 fullScreen 0
 rect 0 0 640 480
 visible 0
 itemDef {
  name "colour"
  rect 0 0 640 480
  style WINDOW_STYLE_FILLED
  backcolor 0 0 0 0
  visible 1
  decoration
 }
}

menuDef {
 name "fadebox_black"
 fullScreen 0
 rect 0 0 640 480
 visible 1
 alwaysontop
 itemDef {
  name "fadebox"
  rect 0 0 640 480
  style WINDOW_STYLE_FILLED
  backcolor 0 0 0 0
  visible 1
  decoration
 }
}
