// Map chooser: maps with bot navigation first, then human-only maps.
menuDef {
 name "slice_maps"
 rect 8 8 624 464
 fullscreen 0
 visible 0
 onOpen { hide artfocus ; clearFocus ; uiScript sliceMaps }
 onESC { close slice_maps ; open main }
 PANEL( 0, 0, 624, 464 )
 TITLEBAR( 10, 8, 604, 24, "CHOOSE MAP", .22 )
 LABELWHITE( 14, 38, 360, 16, "MAP", .23, ITEM_ALIGN_LEFT, 0, 12 )
 LABELWHITE( 270, 38, 70, 16, "BOTS", .23, ITEM_ALIGN_LEFT, 0, 12 )
 INSET( 6, 54, 392, 352 )
 itemDef {
  name "mapList"
  rect 12 60 380 340
  type ITEM_TYPE_LISTBOX
  // Highlighted map name, for controller checks; the choice applies only on A.
  cvar "ui_rustMapPick"
  forecolor .9 .9 .88 1
  border WINDOW_BORDER_FULL
  bordercolor 0 0 0 0
  outlinecolor .62 .5 .25 .45
  textfont UI_FONT_COURBD_21
  textscale .3
  textaligny -6
  elementwidth 364
  elementheight 22
  elementtype LISTBOX_TEXT
  columns 2 2 248 20 258 96 8
  feeder 64
  visible 1
  onFocus { setitemcolor mapList bordercolor .78 .63 .33 .9 }
  leaveFocus { setitemcolor mapList bordercolor 0 0 0 0 }
  onEnter { uiScript sliceMapPick }
  doubleClick { uiScript sliceMapPick }
 }
 INSET( 404, 54, 214, 166 )
 itemDef {
  name "mapShot"
  rect 412 62 198 150
  style WINDOW_STYLE_SHADER
  background "levelshots/unknownmap"
  visible 1
  decoration
 }
 itemDef {
  name "mapPickName"
  rect 406 228 210 16
  type ITEM_TYPE_TEXT
  cvar "ui_rustMapPickName"
  textfont UI_FONT_COURBD_21
  textstyle ITEM_TEXTSTYLE_SHADOWED
  textscale .24
  textaligny 12
  forecolor .95 .95 .88 1
  visible 1
  decoration
 }
 itemDef {
  name "mapPickFile"
  rect 406 246 210 14
  type ITEM_TYPE_TEXT
  cvar "ui_rustMapPick"
  textfont UI_FONT_COURBD_21
  textscale .18
  textaligny 10
  forecolor .63 .66 .61 1
  visible 1
  decoration
 }
 itemDef {
  name "mapPickBots"
  rect 406 264 210 14
  type ITEM_TYPE_TEXT
  cvar "ui_rustMapPickBots"
  textfont UI_FONT_COURBD_21
  textscale .17
  textaligny 10
  forecolor .8 .8 .74 1
  visible 1
  decoration
 }
 CONTEXTHELP( 406, 286, 204, 60, "Stock and downloaded maps. Server-mod maps are excluded. NO BOTS: human players only." )
 ARTBUTTON( 410, 352, 204, 24, "PLAY THIS MAP", .26, 17, uiScript sliceMapPick )
 ARTBUTTON( 410, 382, 204, 24, "BACK", .28, 17, close slice_maps ; open main )
 LABELWHITE( 12, 418, 600, 12, "D-pad / left stick: move   A: choose map   B: back", .22, ITEM_ALIGN_CENTER, 300, 10 )
 LABEL( 12, 434, 600, 12, "Right from the list: buttons. Bot maps are listed first.", .2, ITEM_ALIGN_CENTER, 300, 10 )
}

menuDef {
 name "ingame_main"
 rect 0 0 640 480
 fullscreen 0
 visible 0
 onOpen { hide artfocus ; conditionalScript ui_rustVideoPending 0 ( "open vid_confirm" ) ( "clearFocus" ) }
 onESC { uiScript closeingame }
 ARTWINDOW( 184, 98, 272, 342, "MATCH MENU" )
 ARTBUTTON( 208, 140, 224, 26, "RESUME", .3, 19, uiScript closeingame )
 ARTBUTTON( 208, 176, 224, 26, "CHANGE TEAM / CLASS / LOADOUT", .21, 19, uiScript sliceLoadout )
 ARTBUTTON( 208, 212, 224, 26, "OPTIONS", .3, 19, close ingame_main ; open options_system )
 ARTBUTTON( 208, 248, 224, 26, "LEAVE MATCH", .3, 19, uiScript Leave )
 ARTBUTTON( 208, 284, 224, 26, "QUIT", .3, 19, uiScript Quit )
 ARTBUTTON( 208, 320, 224, 26, "SERVER INFORMATION", .24, 19, close ingame_main ; open ingame_serverinfo )
 ARTBUTTON( 208, 356, 224, 26, "CALL VOTE", .24, 19, uiScript clientCheckVote ; conditionalScript cg_ui_novote 0 ( "clearFocus ; open ingame_votedisabled" ) ( "close ingame_main ; open ingame_vote" ) )
 LABEL( 200, 394, 240, 14, "Esc / Start: menu   L / Back: limbo", .18, ITEM_ALIGN_CENTER, 120, 10 )
 CONTEXTHELP( 200, 412, 240, 24, "The match continues while this menu is open." )
}

menuDef {
 name "options_system"
 rect 96 8 448 464
 fullscreen 0
 visible 0
 onOpen { hide artfocus ; uiScript systemCvarsGet ; uiScript vidSave ; uiScript sliceOptionsGet }
 onESC { uiScript systemCvarsReset ; uiScript vidConfirm ; uiScript sliceBack }
 PANEL( 0, 0, 448, 464 )
 TITLEBAR( 10, 10, 428, 22, "DISPLAY", .2 )
 INSET( 12, 56, 424, 256 )
 ARTBUTTON( 18, 34, 412, 20, "USE MONITOR RESOLUTION / REFRESH", .25, 15, uiScript sliceMonitor )
 LABEL( 18, 58, 412, 12, "Resolutions supported by this monitor, or use the button above", .2, ITEM_ALIGN_CENTER, 206, 9 )
 // Filled on open from the monitor's modes (uiScript sliceOptionsGet); Apply uses the choice.
 MULTI( 18, 78, 412, 18, "Resolution:", .25, 13, "ui_rustResolution", cvarStrList { "Current"; "current" }, "Left / Right: resolutions this monitor supports" )
 YESNO( 18, 98, 412, 18, "Fullscreen:", .25, 13, "ui_r_fullscreen", "Windowed or fullscreen" )
 MULTI( 18, 118, 412, 18, "Refresh:", .25, 13, "ui_r_displayRefresh", cvarFloatList { "Desktop" 0 "60 Hz" 60 "75 Hz" 75 "100 Hz" 100 "120 Hz" 120 "144 Hz" 144 "165 Hz" 165 "200 Hz" 200 "240 Hz" 240 }, "Select a rate supported by your monitor" )
 YESNO( 18, 138, 412, 18, "V-Sync:", .25, 13, "ui_r_swapInterval", "Synchronize with monitor refresh" )
 NUMERICFIELD( 18, 158, 412, 18, "FPS cap (0 = off):", .25, 13, "ui_com_maxfps", 4, "Use 0 with V-Sync" )
 MULTI( 18, 178, 412, 18, "Texture detail:", .25, 13, "ui_r_picmip", cvarFloatList { "Full" 0 "Half" 1 "Quarter" 2 }, "Original game textures" )
 MULTI( 18, 198, 412, 18, "Texture filter:", .25, 13, "ui_r_texturemode", cvarStrList { "Bilinear"; "GL_LINEAR_MIPMAP_NEAREST"; "Trilinear"; "GL_LINEAR_MIPMAP_LINEAR" }, "Native texture filtering" )
 YESNO( 18, 218, 412, 18, "Anisotropic filtering:", .25, 13, "ui_r_ext_texture_filter_anisotropic", "When supported by the GPU" )
 MULTI( 18, 238, 412, 18, "Filtering level:", .25, 13, "ui_r_textureAnisotropy", cvarFloatList { "1x" 1 "2x" 2 "4x" 4 "8x" 8 "16x" 16 }, "GPU-supported maximum applies" )
 CONTEXTHELP( 18, 264, 412, 28, "Numbers: A to edit / arrows change digits / X delete / B cancel" )
 itemDef {
  name "resolutionError"
  rect 18 296 412 12
  type ITEM_TYPE_TEXT
  cvar "ui_rustOptionsError"
  textfont UI_FONT_COURBD_21
  textscale .18
  textalign ITEM_ALIGN_CENTER
  textalignx 206
  textaligny 9
  forecolor 1 .5 .4 1
  visible 1
  decoration
 }
 TITLEBAR( 10, 316, 428, 18, "AUDIO / INPUT", .17 )
 INSET( 12, 336, 424, 56 )
 SLIDER( 18, 340, 412, 14, "Effects volume:", .23, 10, "s_volume" .7 0 1, "Native audio" )
 SLIDER( 18, 356, 412, 14, "Music volume:", .23, 10, "s_musicvolume" .25 0 1, "Native menu music" )
 SLIDER( 18, 372, 412, 14, "Mouse sensitivity:", .23, 10, "ui_sensitivity" 5 .1 20, "Mouse aim sensitivity" )
 LABEL( 18, 394, 412, 10, "WASD / Mouse fire / Space jump / Ctrl crouch / Shift sprint / R reload", .15, ITEM_ALIGN_CENTER, 206, 8 )
 ARTBUTTON( 18, 406, 196, 20, "GAMEPAD SETTINGS", .23, 15, open options_gamepad )
 ARTBUTTON( 18, 430, 196, 20, "BACK", .28, 15, uiScript systemCvarsReset ; uiScript vidConfirm ; uiScript sliceBack )
 ARTBUTTON( 234, 430, 196, 20, "APPLY", .28, 15, uiScript sliceApply )
 ARTBUTTON( 234, 406, 196, 20, "ORIGINAL ET OPTIONS", .21, 15, uiScript systemCvarsReset ; close options_system ; open options )
}

menuDef {
 name "options_gamepad"
 popup
 modal
 rect 96 8 448 464
 fullscreen 0
 visible 0
 onOpen { hide artfocus }
 onESC { close options_gamepad }
 ARTWINDOW( 0, 0, 448, 464, "GAMEPAD / AIM ASSIST" )
 INSET( 12, 30, 424, 268 )
 YESNO( 18, 34, 412, 14, "Enable XInput controller:", .23, 10, "in_gamepad", "Xbox-compatible controllers; reconnect automatically" )
 SLIDER( 18, 58, 412, 14, "Move stick deadzone:", .23, 10, "cl_gamepadMoveDeadzone" .2 0 .5, "Increase to stop stick drift" )
 SLIDER( 18, 82, 412, 14, "Look stick deadzone:", .23, 10, "cl_gamepadLookDeadzone" .2 0 .5, "Increase to stop stick drift" )
 SLIDER( 18, 106, 412, 14, "Horizontal look speed:", .23, 10, "cl_gamepadYawSpeed" 120 30 360, "Degrees per second before pegged-stick acceleration" )
 SLIDER( 18, 130, 412, 14, "Vertical look speed:", .23, 10, "cl_gamepadPitchSpeed" 90 30 240, "Degrees per second" )
 YESNO( 18, 154, 412, 14, "Invert vertical look:", .23, 10, "cl_gamepadInvert", "Invert only controller look, not mouse" )
 SLIDER( 18, 178, 412, 14, "Turn acceleration:", .23, 10, "cl_gamepadAccelScale" 2 1 4, "Hold the look stick fully sideways for faster turns" )
 YESNO( 18, 202, 412, 14, "Aiming assistance:", .23, 10, "cg_gamepadAimAssist", "Controller-only slowdown and adhesion for SMGs and rifles" )
 MULTI( 18, 226, 412, 14, "Aim assist strength:", .23, 10, "cl_gamepadAssistStrength", cvarFloatList { "Very low" .4 "Low" .7 "Normal" 1 "High" 1.3 "Very high" 1.6 "Maximum" 2 }, "Left / Right: weaker or stronger slowdown and tracking near targets" )
 SLIDER( 18, 250, 412, 14, "Target slowdown:", .23, 10, "cl_gamepadFriction" .65 0 1, "Fine tuning: look speed reduction near visible enemies" )
 SLIDER( 18, 274, 412, 14, "Target tracking:", .23, 10, "cl_gamepadAdhesion" .45 0 1, "Fine tuning: bounded tracking while moving or using the look stick" )
 LABEL( 18, 302, 412, 14, "Sticks move/look / RT fire / LT zoom / X reload / A jump / B crouch", .18, ITEM_ALIGN_CENTER, 206, 10 )
 LABEL( 18, 318, 412, 14, "LB sprint / RB activate / tap Y next weapon / HOLD Y equipment wheel", .18, ITEM_ALIGN_CENTER, 206, 10 )
 LABEL( 18, 334, 412, 14, "Tap Up alt mode / HOLD Up class requests / Down prone / Left-Right lean", .18, ITEM_ALIGN_CENTER, 206, 10 )
 LABEL( 18, 350, 412, 14, "Back: limbo / hold L3: scores / hold RS: map / Start: menu", .18, ITEM_ALIGN_CENTER, 206, 10 )
 CONTEXTHELP( 18, 368, 412, 30, "Changes save immediately. D-pad: adjust / A: select / B: back" )
 ARTBUTTON( 18, 430, 412, 20, "BACK", .28, 15, close options_gamepad )
 ARTBUTTON( 18, 402, 412, 20, "RADIAL MENU SETTINGS", .24, 15, open options_radial )
}

menuDef {
 name "options_radial"
 popup
 modal
 rect 96 90 448 300
 fullscreen 0
 visible 0
 onOpen { hide artfocus }
 onESC { close options_radial }
 ARTWINDOW( 0, 0, 448, 300, "CONTROLLER RADIAL MENUS" )
 INSET( 12, 38, 424, 84 )
 SLIDER( 18, 42, 412, 14, "Hold delay (ms):", .23, 10, "cl_gamepadWheelHold" 150 100 1000, "Tap Y cycles weapons; hold Y opens equipment. Tap Up alternate; hold Up class requests." )
 SLIDER( 18, 70, 412, 14, "Wheel stick deadzone:", .23, 10, "cl_gamepadRadialDeadzone" .35 .15 .8, "Increase to avoid accidental selection from stick drift." )
 YESNO( 18, 98, 412, 14, "Wheel center help:", .23, 10, "cl_gamepadRadialHelp", "Show the center disc with the wheel name and highlighted choice" )
 CONTEXTHELP( 18, 126, 412, 32, "Changes save immediately. B: back to gamepad settings." )
 LABELWHITE( 18, 162, 412, 14, "Equipment: hold Y / LEFT stick / release Y to equip", .21, ITEM_ALIGN_CENTER, 206, 10 )
 LABEL( 18, 182, 412, 14, "Class request: hold Up / RIGHT stick / release Up to send", .19, ITEM_ALIGN_CENTER, 206, 10 )
 LABEL( 18, 202, 412, 14, "Select with the stick held / release at center selects nothing", .19, ITEM_ALIGN_CENTER, 206, 10 )
 LABEL( 18, 220, 412, 14, "No confirm or cancel buttons / selected icon flashes briefly", .19, ITEM_ALIGN_CENTER, 206, 10 )
 LABEL( 18, 240, 412, 14, "Only your view is blocked; the match and other players continue", .18, ITEM_ALIGN_CENTER, 206, 10 )
 ARTBUTTON( 18, 262, 412, 20, "BACK", .28, 15, close options_radial )
}
