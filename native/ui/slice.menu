// Unified shell: original ET local objectives plus the simplified online browser.
#include "ui/menudef.h"
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 640
#define WINDOW_HEIGHT 480
#define GROUP_NAME "slice"
#include "ui/menumacros.h"
#include "ui/slicemacros.h"

menuDef {
 name "main"
 rect 0 0 640 480
 fullscreen 1
 visible 0
 onOpen { hide artfocus ; uiScript sliceMapsMain ; conditionalScript ui_rustVideoPending 0 ( "open vid_confirm" ) ( "clearFocus" ) }
 // Arcade Edition wordmark (tools/brand.py) above the window.
 ART_PIECE( 170, 4, 300, 84, "ui/art/logo", "logo", "art", 1 )
 ARTWINDOW( 168, 90, 304, 344, "MAIN MENU" )
 LABEL( 184, 134, 272, 14, "Original ET objectives with Omni-bot", .2, ITEM_ALIGN_CENTER, 136, 10 )
 // Online needs the unified engine; its art follows the same cvar test.
 ART_THREE_IF( 192, 152, 256, 24, .088, "ui/art/button3", "bnPLAY ONLINE", "art", 1, "et_unified" )
 ART_THREE_IF( 192, 152, 256, 24, .088, "ui/art/button_focus3", "bfPLAY ONLINE", "artfocus", 0, "et_unified" )
 itemDef {
  name "online"
  rect 192 152 256 24
  type ITEM_TYPE_BUTTON
  text "PLAY ONLINE"
  textfont UI_FONT_COURBD_30
  textstyle ITEM_TEXTSTYLE_SHADOWED
  textscale .28
  textalign ITEM_ALIGN_CENTER
  textalignx 128
  textaligny 17
  forecolor .78 .77 .7 1
  visible 1
  cvarTest "et_unified"
  showCvar { "1" }
  mouseEnter { show "bfPLAY ONLINE" ; setitemcolor online forecolor 1 .86 .58 1 }
  mouseExit { hide "bfPLAY ONLINE" ; setitemcolor online forecolor .78 .77 .7 1 }
  action { hide "bfPLAY ONLINE" ; setitemcolor online forecolor .78 .77 .7 1 ; uiScript sliceBrowse }
 }
 ARTBUTTON( 192, 182, 256, 26, "START MATCH", .3, 19, uiScript sliceStart )
 FIELD( 186, 216, 268, 20 )
 MULTI( 192, 217, 256, 18, "Players:", .23, 13, "cl_splitScreen", cvarFloatList { "1" 0 "2 split-screen" 1 "3 split + map" 3 "4 split-screen" 4 }, "Local and online. 2: side-by-side; 3: 2x2 with live map; 4: 2x2" )
 FIELD( 186, 240, 268, 20 )
// Stock and downloaded maps (native/map_list.c); A opens the chooser.
 itemDef {
  name "mapButton"
  rect 192 241 256 18
  type ITEM_TYPE_BUTTON
  text "Map:"
  textfont UI_FONT_COURBD_21
  textstyle ITEM_TEXTSTYLE_SHADOWED
  textscale .23
  textalign ITEM_ALIGN_RIGHT
  textalignx 128
  textaligny 13
  forecolor .6 .6 .6 1
  visible 1
  tooltip "Stock maps and maps downloaded from online servers"
  mouseEnter { setitemcolor mapButton forecolor .9 .9 .9 1 ; setitemcolor mapValue forecolor .9 .9 .9 1 }
  mouseExit { setitemcolor mapButton forecolor .6 .6 .6 1 ; setitemcolor mapValue forecolor .6 .6 .6 1 }
  action { play "sound/menu/select.wav" ; close main ; open slice_maps }
 }
 itemDef {
  name "mapValue"
  rect 324 241 124 18
  type ITEM_TYPE_TEXT
  cvar "ui_rustMapLabel"
  textfont UI_FONT_COURBD_21
  textstyle ITEM_TEXTSTYLE_SHADOWED
  textscale .2
  textaligny 13
  forecolor .6 .6 .6 1
  visible 1
  decoration
 }
 FIELD( 186, 264, 268, 20 )
 MULTI( 192, 265, 256, 18, "Total players:", .23, 13, "ui_matchPlayers", cvarFloatList { "4 (2 per team)" 4 "8 (4 per team)" 8 "12 (6 per team)" 12 "16 (8 per team)" 16 "24 (12 per team)" 24 "32 (16 per team)" 32 "40 (20 per team)" 40 "48 (24 per team)" 48 }, "Humans included; bots fill and balance both teams; next match" )
 ARTBUTTON( 192, 292, 256, 24, "PLAYERS & CONTROLLERS", .24, 17, close main ; open players_setup )
 ARTBUTTON( 192, 320, 256, 24, "OPTIONS", .28, 17, close main ; open options_system )
 ARTBUTTON( 192, 348, 256, 24, "QUIT", .28, 17, uiScript Quit )
 CONTEXTHELP( 184, 380, 272, 28, "Local match: choose team and class after the map loads." )
 itemDef {
  name "mapNote"
  rect 184 412 272 14
  type ITEM_TYPE_TEXT
  cvar "ui_rustMapNote"
  textfont UI_FONT_COURBD_21
  textstyle ITEM_TEXTSTYLE_SHADOWED
  textscale .18
  textalign ITEM_ALIGN_CENTER
  textalignx 136
  textaligny 10
  forecolor .6 .6 .6 1
  visible 1
  decoration
 }
}

// Player setup: profile and controller per player, keyboard & mouse owner, new profiles.
menuDef {
 name "players_setup"
 rect 8 8 624 464
 fullscreen 0
 visible 0
 onOpen { hide artfocus ; clearFocus ; uiScript slicePlayers }
 onESC { close players_setup ; open main }
 PANEL( 0, 0, 624, 464 )
